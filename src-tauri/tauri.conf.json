{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Cache Watch",
  "version": "0.1.0",
  "identifier": "local.claude-cache-watch",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Claude Cache Watch",
      "width": 1180,
      "height": 800,
      "minWidth": 840,
      "minHeight": 600,
      "visible": false
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
